rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Students Collection
    // Allows full CRUD for students data
    match /students/{studentId} {
      // Allow anyone to read and write for now (development)
      // In production, replace with: allow read, write: if request.auth != null;
      allow read, write: if true;
    }
    
    // Cafeterias Collection
    // Allows full CRUD for cafeteria data
    match /cafeterias/{cafeteriaId} {
      // Allow anyone to read and write for now (development)
      allow read, write: if true;
    }
    
    // Settings Collection
    // Allows reading and updating meal settings
    match /settings/{document=**} {
      // Allow anyone to read and write for now (development)
      allow read, write: if true;
    }
    
    // Meal Logs Collection
    // Allows creating and reading scan logs
    match /mealLogs/{logId} {
      // Allow anyone to read and write for now (development)
      allow read, write: if true;
    }
  }
}

/* 
 * PRODUCTION SECURITY RULES (Use these when adding authentication):
 * 
 * Replace all "allow read, write: if true;" with:
 * "allow read, write: if request.auth != null;"
 * 
 * This will require users to be authenticated before accessing data.
 * 
 * For more granular control, you can use:
 * - allow read: if request.auth != null;
 * - allow create, update: if request.auth != null && request.auth.token.admin == true;
 * - allow delete: if request.auth != null && request.auth.token.admin == true;
 */
